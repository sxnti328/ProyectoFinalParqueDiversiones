<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="24" prefWidth="600" prefHeight="480"
      style="-fx-background-color: #1a252f;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalparque.controller.MainController">

    <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>

    <Label text="🎡 Tech-Park UQ"
           style="-fx-font-size:34; -fx-font-weight:bold; -fx-text-fill:#f39c12;"/>

    <Label text="Sistema de Gestión del Parque"
           style="-fx-font-size:15; -fx-text-fill:#bdc3c7;"/>

    <Region prefHeight="20"/>

    <Button text="👤  Acceso Visitante"
            prefWidth="300" prefHeight="55"
            onAction="#irAVisitante"
            style="-fx-font-size:15; -fx-background-color:#2980b9; -fx-text-fill:white;
                   -fx-background-radius:8; -fx-cursor:hand;"/>

    <Button text="🔧  Panel Operador"
            prefWidth="300" prefHeight="55"
            onAction="#irAOperador"
            style="-fx-font-size:15; -fx-background-color:#27ae60; -fx-text-fill:white;
                   -fx-background-radius:8; -fx-cursor:hand;"/>

    <Button text="⚙️  Panel Administrador"
            prefWidth="300" prefHeight="55"
            onAction="#irAAdmin"
            style="-fx-font-size:15; -fx-background-color:#8e44ad; -fx-text-fill:white;
                   -fx-background-radius:8; -fx-cursor:hand;"/>

    <Region prefHeight="10"/>

    <Label text="© 2026 Tech-Park UQ"
           style="-fx-font-size:11; -fx-text-fill:#7f8c8d;"/>
</VBox>
