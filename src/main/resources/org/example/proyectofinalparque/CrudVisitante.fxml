<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="8" prefWidth="600" prefHeight="600"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.proyectofinalparque.controller.CrudVisitanteController">

    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <HBox spacing="10">
        <Button text="Volver" onAction="#volver"/>
        <Label text="Gestion de Visitantes"/>
    </HBox>

    <GridPane hgap="8" vgap="5">
        <Label text="Nombre:"     GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre"    GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Documento:"  GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtDocumento" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Edad:"       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEdad"      GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Telefono:"   GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTelefono"  GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Direccion:"  GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtDireccion" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Label text="Estatura:"   GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEstatura"  GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        <Label text="Saldo:"      GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="txtSaldo"     GridPane.rowIndex="6" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="8">
        <Button text="Guardar"    onAction="#guardar"/>
        <Button text="Actualizar" onAction="#actualizar"/>
        <Button text="Eliminar"   onAction="#eliminar"/>
    </HBox>

    <Label fx:id="lblMensaje" text=""/>

    <Label text="Lista de visitantes:"/>
    <TableView fx:id="tablaVisitantes" prefHeight="180">
        <columns>
            <TableColumn fx:id="colNombre"    text="Nombre"    prefWidth="100"/>
            <TableColumn fx:id="colDocumento" text="Documento" prefWidth="90"/>
            <TableColumn fx:id="colEdad"      text="Edad"      prefWidth="50"/>
            <TableColumn fx:id="colTelefono"  text="Telefono"  prefWidth="90"/>
            <TableColumn fx:id="colDireccion" text="Direccion" prefWidth="110"/>
            <TableColumn fx:id="colEstatura"  text="Estatura"  prefWidth="70"/>
            <TableColumn fx:id="colSaldo"     text="Saldo"     prefWidth="80"/>
        </columns>
    </TableView>

    <Label text="Comprar ticket:"/>
    <HBox spacing="8">
        <Label text="Tipo:"/>
        <ComboBox fx:id="cbTipoTicket" prefWidth="120"/>
        <Label text="Precio:"/>
        <TextField fx:id="txtPrecioTicket" prefWidth="100"/>
        <Button text="Comprar" onAction="#comprarTicket"/>
    </HBox>
    <Label fx:id="lblTicketMsg" text=""/>

</VBox>
